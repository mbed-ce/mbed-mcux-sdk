--- a/drivers/flexspi/fsl_flexspi.c
+++ b/drivers/flexspi/fsl_flexspi.c
@@ -124,7 +124,7 @@ static flexspi_isr_t s_flexspiIsr;
 #if defined(__ICCARM__)
 #pragma optimize = none
 #endif /* defined(__ICCARM__) */
